{
  "name": "highordermri-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress src",
    "docs:build": "node build-site.mjs",
    "docs:build-site": "node build-site.mjs",
    "docs:preview": "julia --startup-file=no --project=publish publish/run.jl preview",
