    "docs:check-tools": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "4.3.2",
    "mermaid": "11.17.1",
    "vitepress": "2.0.0-alpha.19"
  }
}
